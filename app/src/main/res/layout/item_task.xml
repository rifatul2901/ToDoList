<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="8dp"
    app:cardElevation="6dp"
    app:cardCornerRadius="12dp"
    android:backgroundTint="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header dengan Judul dan Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Judul Tugas -->
            <TextView
                android:id="@+id/textTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Judul Tugas"
                android:fontFamily="@font/poppinsmedium"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#212121" />

            <!-- Status Completed -->
            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ SELESAI"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_completed_status"
                android:textColor="#4CAF50"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Deadline -->
        <TextView
            android:id="@+id/textDeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Deadline: 2025-05-20"
            android:fontFamily="@font/poppinsregular"
            android:textColor="#FF5722"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp" />

        <!-- Deskripsi Tugas -->
        <TextView
            android:id="@+id/txtTask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Deskripsi lengkap tugas akan ditampilkan di sini."
            android:textSize="15sp"
            android:fontFamily="@font/poppinsregular"
            android:textColor="#424242"
            android:background="?android:selectableItemBackground"
            android:padding="8dp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>